NODE_ENV=development
PORT=3000
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5188
DATABASE_URL=postgresql://top:top@localhost:5432/top
DATABASE_ENABLED=false
SESSION_SECRET=replace-this-with-a-long-random-secret-before-production
# The public HTTPS URL used in verification and password-reset emails.
PUBLIC_APP_URL=http://127.0.0.1:5188
# Use a distinct 32+ character value in production. It signs one-time account links.
ACCOUNT_ACTION_SECRET=replace-this-with-a-different-long-random-secret
# Optional email delivery through Resend. Without these, development prints a safe local action link.
RESEND_API_KEY=
EMAIL_FROM=TOP <hello@example.com>
# Optional server-side incident webhook. It receives metadata only, never passwords or cookies.
ERROR_WEBHOOK_URL=
